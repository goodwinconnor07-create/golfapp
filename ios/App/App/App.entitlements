<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Invite links (https://…/j/CODE) open the app when it's installed.
	     The site serves the matching /.well-known/apple-app-site-association. -->
	<!-- Push notifications. Xcode switches this to production for TestFlight and App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cardshot.link</string>
		<string>applinks:send-it.kavishahtemu11.workers.dev</string>
	</array>
</dict>
</plist>
