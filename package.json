{
  "name": "send-it",
  "private": true,
  "version": "0.1.0",
  "description": "CardShot: a risk-and-reward party game layer for a casual round of golf.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "balance": "esbuild scripts/balance/run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.tmp/balance.mjs && node node_modules/.tmp/balance.mjs",
    "format": "prettier --write .",
    "build:ios": "VITE_SERVER_URL=${SERVER_URL:-https://cardshot.link} vite build && cap sync ios",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "icons": "node --experimental-strip-types scripts/make-icons.ts",
    "store:seed": "esbuild marketing/app-store/seed.ts --bundle --platform=node --format=esm --log-level=warning --outfile=marketing/app-store/seed.bundle.mjs && node marketing/app-store/seed.bundle.mjs",
    "store:capture": "playwright test -c marketing/app-store/capture.config.ts",
    "store:render": "node marketing/app-store/render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
