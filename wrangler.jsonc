// Cloudflare config for Send It.
// One Worker serves the built app (static assets) and the online game API.
// Each online game lives in its own GameRoom Durable Object, keyed by join code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "send-it",
  "main": "./worker/index.ts",
  // Keep the old address working: the iPhone app and links already shared point at it.
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  // The site's own address and the short join link (cardshot.link/ABCDE). The domain has to be a zone in this Cloudflare account.
  "routes": [{ "pattern": "cardshot.link", "custom_domain": true }],
  "assets": {
    // Unknown paths (like /j/BCDFG join links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker code; everything else is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      // Saved course lookups, so GolfCourseAPI is asked about each course once.
      { "name": "COURSE_STORE", "class_name": "CourseStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["CourseStore"] },
  ],
  "observability": { "enabled": true },
}
